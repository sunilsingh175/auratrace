{
  "name": "@auratrace/node",
  "version": "2.0.0",
  "type": "module",
  "description": "Official Node.js Telemetry & Crash Diagnostic SDK for AuraTrace Autonomous Backend Diagnostics",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "npx tsx test/automatic-crash-capture.test.ts && npx tsx test/client.test.ts && npx tsx test/transport.test.ts",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "auratrace",
    "observability",
    "apm",
    "telemetry",
    "tracing",
    "anomaly-detection",
    "ai-diagnostics"
  ],
  "author": "Sunil Singh <sunilsinghrajput192@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.24",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
