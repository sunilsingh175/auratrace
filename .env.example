# ==============================================================================
# Automatic Backend Detection Global Environment Configuration Template
# ==============================================================================

# PostgreSQL & pgvector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=trace_db
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password_here@postgres-db:5432/trace_db

# Redis
REDIS_HOST=redis-broker
REDIS_PORT=6379
REDIS_STREAM_KEY=telemetry_stream
REDIS_ANOMALY_CHANNEL=anomaly_events
REDIS_CONSUMER_GROUP=trace_workers

# FastAPI Gateway & Authentication
INGESTION_SERVICE_PORT=8000
AURA_MASTER_API_KEY=your_master_api_key_here
ENABLE_API_AUTH=true
AURA_AUTH_SECRET=replace_with_a_long_random_secret
AURA_ADMIN_REGISTRATION_KEY=replace_with_admin_registration_key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password
AURA_SESSION_TTL_SECONDS=28800
AURA_OTP_TTL_SECONDS=300
AURA_OTP_RESEND_SECONDS=30
AURA_OTP_MAX_ATTEMPTS=5

# Email OTP delivery (required for real email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM=your_email@example.com

# ML Anomaly Detection
ANOMALY_THRESHOLD=0.75
ANOMALY_CONTAMINATION=0.05
ANOMALY_WINDOW_SIZE_SECONDS=300
ANOMALY_POLL_INTERVAL_MS=1000

# RAG AI Doctor
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/telemetry
