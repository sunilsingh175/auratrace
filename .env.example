# ==============================================================================
# AuraTrace Global Environment Configuration Template
# ==============================================================================

# PostgreSQL & pgvector Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_123
POSTGRES_DB=auratrace_db
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password_123@postgres-db:5432/auratrace_db

# Redis Stream & Pub/Sub Broker
REDIS_HOST=redis-broker
REDIS_PORT=6379
REDIS_STREAM_KEY=telemetry_stream
REDIS_ANOMALY_CHANNEL=anomaly_alerts
REDIS_CONSUMER_GROUP=auratrace_workers

# Ingestion Service (FastAPI)
INGESTION_SERVICE_PORT=8000
AURA_MASTER_API_KEY=aura_secret_key_123

# ML Anomaly Detection Service
ANOMALY_CONTAMINATION=0.05
ANOMALY_WINDOW_SIZE_SECONDS=300
ANOMALY_POLL_INTERVAL_MS=1000

# RAG AI Diagnostic Doctor
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Next.js Frontend Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/telemetry
