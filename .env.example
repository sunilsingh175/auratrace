# AuraTrace environment template
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=auratrace_db
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:change_me@postgres-db:5432/auratrace_db

REDIS_HOST=redis-broker
REDIS_PORT=6379
REDIS_STREAM_KEY=telemetry_stream
REDIS_ANOMALY_CHANNEL=anomaly_events

INGESTION_SERVICE_PORT=8000
AURA_MASTER_API_KEY=change_me_to_a_long_random_value

ANOMALY_CONTAMINATION=0.05
ANOMALY_WINDOW_SIZE_SECONDS=300
ANOMALY_POLL_INTERVAL_MS=1000

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/telemetry
# Server-only variables used by the Next.js API proxy:
AURA_API_URL=http://localhost:8000
AURA_MASTER_API_KEY=change_me_to_a_long_random_value
